#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

PROG=/usr/bin/higorosd

ensure_uhttpd_on_8080() {
	local needs_update=0
	local listen_http

	listen_http="$(uci -q show uhttpd 2>/dev/null | grep "uhttpd.main.listen_http" || true)"

	if echo "$listen_http" | grep -qE "[:\\]]80'?$"; then
		needs_update=1
	fi

	if ! echo "$listen_http" | grep -qE "[:\\]]8080'?$"; then
		needs_update=1
	fi

	[ "$needs_update" -eq 1 ] || return 0

	uci -q delete uhttpd.main.listen_http
	uci add_list uhttpd.main.listen_http='0.0.0.0:8080'
	uci add_list uhttpd.main.listen_http='[::]:8080'
	uci commit uhttpd
	/etc/init.d/uhttpd restart >/dev/null 2>&1
}

start_service() {
	[ -x "$PROG" ] || return 1

	ensure_uhttpd_on_8080

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		HIGOROS_ADDR=0.0.0.0:80 \
		HIGOROS_FRONTEND_DIR=/www/higoros \
		HIGOROS_LUA_HANDLERS=/usr/share/higoros/lua/handlers \
		HIGOROS_CORS_ORIGIN=*
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
