#!/bin/sh
set -eu

# PROJECT_LOCAL route identity. Protocol 242 is intentionally numeric and
# reserved by this project; never weaken ownership to prefix-only deletion.
CELLULAR_INTERFACE=USBv6
LAN_INTERFACE=lan
LAN_DEVICE=br-lan
ROUTE_METRIC=1
ROUTE_PROTOCOL=242
STATE_FILE=/var/run/h5000m-ipv6-route.state
LOCK_DIR=/var/run/h5000m-ipv6-route.lock
JSHN=/usr/share/libubox/jshn.sh

log_error() {
	logger -t h5000m-ipv6-route "error=$1"
}

fail() {
	log_error "$1"
	exit 1
}

valid_prefix() {
	# A canonical global-unicast /64 network address has a 2/3 first nibble,
	# lowercase hex, no zone, and the all-zero host half compressed at the end.
	printf '%s\n' "$1" | grep -Eq '^[23][0-9a-f]{0,3}(:[0-9a-f]{1,4}){0,3}::/64$'
}

lock_acquire() {
	umask 077
	mkdir "$LOCK_DIR" 2>/dev/null || fail lock_busy
	trap 'rmdir "$LOCK_DIR" 2>/dev/null || true; [ -z "${SNAPSHOT:-}" ] || rm -f "$SNAPSHOT"' EXIT HUP INT TERM
}

route_protocol_supported() {
	# Read-only parser probe: unsupported numeric protocol syntax fails closed.
	ip -6 route show proto "$ROUTE_PROTOCOL" >/dev/null 2>&1
}

route_lines() {
	ip -6 route show 2>/dev/null || return 1
}

owned_routes() {
	route_lines | awk -v d="$LAN_DEVICE" -v m="$ROUTE_METRIC" -v p="$ROUTE_PROTOCOL" '
		function has_pair(key, value, i) {
			for (i = 1; i < NF; i++) if ($i == key && $(i + 1) == value) return 1
			return 0
		}
		has_pair("dev", d) && has_pair("metric", m) && has_pair("proto", p) { print $1 }
	'
}

ownership_conflict() {
	prefix=$1
	route_lines | awk -v x="$prefix" -v d="$LAN_DEVICE" -v m="$ROUTE_METRIC" -v p="$ROUTE_PROTOCOL" '
		function value(key, i) {
			for (i = 1; i < NF; i++) if ($i == key) return $(i + 1)
			return ""
		}
		$1 == x && value("dev") == d && value("metric") == m && value("proto") != p { found=1 }
		END { exit(found ? 0 : 1) }
	'
}

route_is_owned() {
	prefix=$1
	owned_routes | grep -Fqx "$prefix"
}

route_lookup_is_lan() {
	prefix=$1
	probe=${prefix%/64}1
	ip -6 route get "$probe" 2>/dev/null | awk -v d="$LAN_DEVICE" '
		{ for (i = 1; i < NF; i++) if ($i == "dev" && $(i + 1) == d) found=1 }
		END { exit(found ? 0 : 1) }
	'
}

delete_owned() {
	prefix=$1
	valid_prefix "$prefix" || return 1
	route_is_owned "$prefix" || return 0
	ip -6 route del "$prefix" dev "$LAN_DEVICE" metric "$ROUTE_METRIC" proto "$ROUTE_PROTOCOL" >/dev/null 2>&1 || return 1
	! route_is_owned "$prefix"
}

state_write() {
	prefix=$1
	tmp="${STATE_FILE}.tmp.$$"
	printf '%s\n' "$prefix" >"$tmp" || return 1
	mv -f "$tmp" "$STATE_FILE" || { rm -f "$tmp"; return 1; }
}

state_read() {
	[ -f "$STATE_FILE" ] || return 1
	IFS= read -r prefix <"$STATE_FILE" || return 1
	valid_prefix "$prefix" || return 1
	printf '%s\n' "$prefix"
}

collect_interface_prefixes() {
	wanted=$1
	field=$2
	json_select interface || return 1
	json_get_keys interface_keys
	for interface_key in $interface_keys; do
		json_select "$interface_key" || continue
		json_get_var logical interface
		if [ "$logical" = "$wanted" ]; then
			json_get_type field_type "$field"
			if [ "$field_type" = array ]; then
				json_select "$field"
				json_get_keys prefix_keys
				for prefix_key in $prefix_keys; do
					json_select "$prefix_key" || continue
					json_get_var address address
					json_get_var mask mask
					[ -n "$address" ] && [ "$mask" = 64 ] && printf '%s/64\n' "$address"
					json_select ..
				done
				json_select ..
			fi
		fi
		json_select ..
	done
	json_select ..
}

select_shared_prefix() {
	cell=$(collect_interface_prefixes "$CELLULAR_INTERFACE" ipv6-prefix | sort -u)
	lan=$(collect_interface_prefixes "$LAN_INTERFACE" ipv6-prefix-assignment | sort -u)
	shared=$(printf '%s\n' "$cell" | while IFS= read -r candidate; do
		[ -n "$candidate" ] || continue
		valid_prefix "$candidate" || continue
		printf '%s\n' "$lan" | grep -Fqx "$candidate" && printf '%s\n' "$candidate"
	done | sort -u)
	[ "$(printf '%s\n' "$shared" | grep -c .)" -eq 1 ] || return 1
	printf '%s\n' "$shared"
}

cleanup_stale_owned() {
	keep=${1:-}
	owned_routes | while IFS= read -r prefix; do
		[ -n "$prefix" ] || continue
		[ "$prefix" = "$keep" ] && continue
		delete_owned "$prefix" || exit 1
	done
}

teardown() {
	old=$(state_read 2>/dev/null || true)
	if [ -n "$old" ]; then
		delete_owned "$old" || fail teardown_delete
	fi
	cleanup_stale_owned "" || fail teardown_stale
	rm -f "$STATE_FILE"
}

reconcile() {
	SNAPSHOT=$(mktemp /tmp/h5000m-ipv6-route.XXXXXX) || fail snapshot_create
	ubus call network.interface dump >"$SNAPSHOT" 2>/dev/null || fail snapshot_read
	json_init
	json_load "$(cat "$SNAPSHOT")" || fail snapshot_parse
	new=$(select_shared_prefix 2>/dev/null || true)
	if [ -z "$new" ]; then
		teardown
		fail prefix_not_unique_shared_global_64
	fi
	ownership_conflict "$new" && fail ownership_conflict
	old=$(state_read 2>/dev/null || true)
	if [ "$old" = "$new" ] && route_is_owned "$new"; then
		cleanup_stale_owned "$new" || fail stale_cleanup
		exit 0
	fi
	ip -6 route replace "$new" dev "$LAN_DEVICE" metric "$ROUTE_METRIC" proto "$ROUTE_PROTOCOL" >/dev/null 2>&1 || fail route_replace
	route_is_owned "$new" || fail route_verify
	route_lookup_is_lan "$new" || fail route_lookup_verify
	state_write "$new" || fail state_write
	if [ -n "$old" ] && [ "$old" != "$new" ]; then
		delete_owned "$old" || fail old_route_delete
	fi
	cleanup_stale_owned "$new" || fail stale_cleanup
}

[ -r "$JSHN" ] || fail jshn_missing
. "$JSHN"
lock_acquire
route_protocol_supported || fail numeric_route_protocol_unsupported

case "${1:-}" in
	reconcile) reconcile ;;
	teardown) teardown ;;
	*) fail invalid_action ;;
esac
